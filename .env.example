# Apify 콘솔 > Settings > API & Integrations 에서 발급
APIFY_TOKEN=

# 아래는 선택. 비용 방어용 한도(기본값이 있어서 안 적어도 된다)
# SEARCH_CACHE_MIN=60       서버 캐시 유지 시간(분)
# SEARCH_LIMIT=10           검색 1회당 가져올 상품 수(1~40, 많을수록 비쌈)
# SEARCH_IP_MAX=8           IP당 10분에 새로 부를 수 있는 횟수
# APIFY_DAILY_LIMIT=200     하루 전체 Apify 호출 상한(추천 칩 검색어는 미리 받아 둬서 세지 않음)
